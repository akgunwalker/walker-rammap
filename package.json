{
  "name": "walker-rammap",
  "version": "1.4.0",
  "private": true,
  "description": "Windows için canlı bellek haritası",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron desktop.js",
    "test": "node --test test/*.test.js",
    "build:windows": "electron-builder --win nsis portable",
    "release": "electron-builder --win nsis portable --publish always"
  },
  "main": "desktop.js",
  "build": {
    "appId": "com.walker.rammap",
    "productName": "Walker RAMMap",
    "asar": true,
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop.js",
      "server.js",
      "advanced-server.js",
      "assets/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "Walker-RAMMap-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Walker RAMMap",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Walker-RAMMap-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "akgunwalker",
      "repo": "walker-rammap",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
